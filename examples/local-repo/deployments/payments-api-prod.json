{
  "name": "payments-api-prod",
  "appRef": "payments-api",
  "environmentRef": "prod-apne2",
  "target": {
    "type": "ecs"
  },
  "strategy": {
    "type": "blueGreen",
    "warmupSeconds": 30,
    "minHealthyPercent": 100
  },
  "traffic": {
    "hostname": "payments.example.com",
    "port": 443
  },
  "capacity": {
    "desired": 3,
    "min": 2,
    "max": 6
  }
}
